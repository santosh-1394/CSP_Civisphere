# =============================================
# CiviSphere - Environment Variables
# =============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# =============================================

# Flask secret key (generate a strong random string)
SECRET_KEY=your-secret-key-here

# MySQL / TiDB Database Connection
MYSQL_HOST=your-database-host.example.com
MYSQL_PORT=4000
MYSQL_USER=your-database-username
MYSQL_PASSWORD=your-database-password
MYSQL_DATABASE=civisphere_db

# SSL Certificate (relative path from project root)
MYSQL_SSL_CA=certs/ca.pem
